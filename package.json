{
  "name": "@hangxingliu/libs",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "main": "index.js",
  "license": "UNLICENSED",
  "author": "hangxingliu <hangxingliu@gmail.com>",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "gen": "bun run --filter '*' gen && bun ./scripts/copy-licenses.mjs",
    "clean": "bun run --filter '*' clean",
    "build": "bun scripts/link-source-files.mjs && bun run --filter '*' build",
    "build:all": "bun scripts/link-source-files.mjs && bun run --filter '*' build:all",
    "test": "bun run --elide-lines=0 --filter '*' test",
    "lint": "bun run --elide-lines=0 --filter '*' lint",
    "hook:install": "husky",
    "hook:remove": "git config --unset core.hooksPath",
    "hook:check": "git config --list | grep core.hooks",
    "start": "tsx"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.22",
    "@types/fs-extra": "^11.0.4",
    "@types/glob": "^9.0.0",
    "@types/node": "^22.20.5",
    "chokidar": "^4.0.3",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "glob": "^14.0.4",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "swc-cli-mux": "^0.7.3",
    "tsx": "^4.23.15",
    "typescript": "=6",
    "typescript-eslint": "^8.72.1"
  }
}
