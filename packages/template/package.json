{
  "name": "@hangxingliu/template",
  "version": "0.0.0",
  "type": "module",
  "main": "cjs/index.cjs",
  "module": "esm/index.mjs",
  "types": "cjs/index.d.ts",
  "files": [
    "src",
    "cjs",
    "esm"
  ],
  "exports": {
    "./cjs/*.js": {
      "require": "./cjs/*.js",
      "import": "./esm/*.js",
      "types": "./cjs/*.d.ts"
    },
    "./esm/*.js": {
      "require": "./cjs/*.js",
      "import": "./esm/*.js",
      "types": "./cjs/*.d.ts"
    },
    "./src/*.js": {
      "require": "./cjs/*.js",
      "import": "./esm/*.js",
      "types": "./cjs/*.d.ts"
    },
    ".": {
      "require": "./cjs/index.cjs",
      "import": "./esm/index.mjs",
      "types": "./cjs/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "build:all": "tsc -b tsconfig.cjs.json tsconfig.json",
    "watch": "tsc -b tsconfig.json --watch",
    "start": "tsc -b tsconfig.json && node esm",
    "clean": "rimraf --glob cjs esm '*.tsbuildinfo'",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.7",
    "eslint": "^9.39.2",
    "mocha": "11.7.5",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3"
  }
}
