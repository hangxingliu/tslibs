{
  "name": "@hangxingliu/ai-utils",
  "version": "1.5.3",
  "type": "module",
  "license": "MIT",
  "main": "cjs/index.js",
  "module": "esm/index.js",
  "types": "cjs/index.d.ts",
  "files": [
    "src",
    "cjs",
    "esm",
    "!**/*.spec.{ts,js}",
    "!**/*.tsbuildinfo"
  ],
  "exports": {
    "./cjs/*.js": {
      "require": "./cjs/*.js",
      "import": "./esm/*.js",
      "types": "./cjs/*.d.ts"
    },
    "./esm/*.js": {
      "require": "./cjs/*.js",
      "import": "./esm/*.js",
      "types": "./cjs/*.d.ts"
    },
    "./src/*.js": {
      "require": "./cjs/*.js",
      "import": "./esm/*.js",
      "types": "./cjs/*.d.ts"
    },
    ".": {
      "require": "./cjs/index.js",
      "import": "./esm/index.js",
      "types": "./cjs/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "build:all": "tsc -b tsconfig.cjs.json tsconfig.json",
    "watch": "tsc -b tsconfig.json --watch",
    "start": "tsc -b tsconfig.json && node esm",
    "clean": "rimraf --glob cjs esm '*.tsbuildinfo'",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.72.1",
    "@google/genai": "^1.39.0",
    "@hangxingliu/common-utils": "workspace:*",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.7",
    "eslint": "^9.39.2",
    "mocha": "11.7.5",
    "openai": "^5.23.2",
    "rimraf": "^6.1.2",
    "type-fest": "^5.4.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "*",
    "@google/genai": "^1",
    "@hangxingliu/common-utils": ">=2",
    "openai": "^5",
    "type-fest": ">=4"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
