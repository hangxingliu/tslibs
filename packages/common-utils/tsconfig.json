{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "removeComments": false,
    "sourceMap": true,
    "skipLibCheck": true,
    "allowJs": true,
    "incremental": true,
    "rootDir": "./src",
    "outDir": "esm",
    "strict": true,
    "types": [
      "node",
      "bun"
    ]
  },
  "exclude": [
    "src/**/*.cts"
  ],
  "include": [
    "src"
  ]
}
