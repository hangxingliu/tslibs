{
  "name": "@hangxingliu/common-utils",
  "version": "3.0.0",
  "type": "module",
  "license": "MIT",
  "module": "esm/index.js",
  "types": "esm/index.d.ts",
  "files": [
    "src",
    "esm",
    "!**/*.spec.{ts,js}",
    "!**/*.tsbuildinfo"
  ],
  "exports": {
    "./esm/*.js": {
      "types": "./esm/*.d.ts",
      "import": "./esm/*.js",
      "default": "./esm/*.js"
    },
    "./src/*.js": {
      "types": "./esm/*.d.ts",
      "import": "./esm/*.js",
      "default": "./esm/*.js"
    },
    ".": {
      "types": "./esm/index.d.ts",
      "import": "./esm/index.js",
      "default": "./esm/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "build:all": "tsc -b tsconfig.json",
    "watch": "tsc -b tsconfig.json --watch",
    "start": "tsc -b tsconfig.json && node esm",
    "clean": "rimraf --glob cjs esm '*.tsbuildinfo'",
    "lint": "eslint src",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.2",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "ajv": "^8",
    "ajv-formats": "^3"
  },
  "peerDependenciesMeta": {
    "ajv": {
      "optional": true
    },
    "ajv-formats": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
