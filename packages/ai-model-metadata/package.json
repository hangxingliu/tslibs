{
  "name": "@hangxingliu/ai-model-metadata",
  "version": "1.0.0",
  "description": "AI SDK independent metadata (prices, limits, thinking capabilities) of LLM models",
  "keywords": [
    "ai",
    "llm",
    "model-metadata",
    "token-pricing",
    "thinking-budget"
  ],
  "type": "module",
  "license": "MIT",
  "module": "esm/index.js",
  "types": "esm/index.d.ts",
  "files": [
    "src",
    "esm",
    "!**/*.spec.*",
    "!**/*.tsbuildinfo"
  ],
  "exports": {
    "./esm/*.js": {
      "types": "./esm/*.d.ts",
      "import": "./esm/*.js",
      "default": "./esm/*.js"
    },
    "./src/*.js": {
      "types": "./esm/*.d.ts",
      "import": "./esm/*.js",
      "default": "./esm/*.js"
    },
    ".": {
      "types": "./esm/index.d.ts",
      "import": "./esm/index.js",
      "default": "./esm/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "build:all": "tsc -b tsconfig.json",
    "watch": "tsc -b tsconfig.json --watch",
    "start": "tsc -b tsconfig.json && node esm",
    "clean": "rimraf --glob esm '*.tsbuildinfo'",
    "lint": "eslint src",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^22.20.1",
    "eslint": "^10.14.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
