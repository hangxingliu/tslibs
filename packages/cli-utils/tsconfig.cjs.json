{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "declaration": true,
    "removeComments": false,
    "sourceMap": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": false,
    "allowJs": true,
    "incremental": true,
    "rootDir": "./src",
    "outDir": "cjs",
    "strict": true,
    "types": [
      "node",
      "bun"
    ]
  },
  "exclude": [
    "src/**/*.mts",
    "src/**/*.spec.*",
    "src/**/*.test.*"
  ],
  "include": [
    "src"
  ]
}
