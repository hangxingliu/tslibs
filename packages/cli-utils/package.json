{
  "name": "@hangxingliu/cli-utils",
  "version": "7.0.0",
  "type": "module",
  "license": "MIT",
  "module": "esm/index.js",
  "types": "esm/index.d.ts",
  "files": [
    "src",
    "esm",
    "!**/*.spec.{ts,js}",
    "!**/*.tsbuildinfo"
  ],
  "exports": {
    "./esm/*.js": {
      "types": "./esm/*.d.ts",
      "import": "./esm/*.js",
      "default": "./esm/*.js"
    },
    "./src/*.js": {
      "types": "./esm/*.d.ts",
      "import": "./esm/*.js",
      "default": "./esm/*.js"
    },
    "./yaml": {
      "types": "./esm/yaml/index.d.ts",
      "import": "./esm/yaml/index.js",
      "default": "./esm/yaml/index.js"
    },
    ".": {
      "types": "./esm/index.d.ts",
      "import": "./esm/index.js",
      "default": "./esm/index.js"
    }
  },
  "scripts": {
    "gen": "node scripts/gen-color-256.mjs --no-ui",
    "build": "bun run gen && tsc -b tsconfig.json",
    "build:all": "bun run gen && tsc -b tsconfig.json",
    "watch": "tsc -b tsconfig.json --watch",
    "start": "tsc -b tsconfig.json && node esm",
    "clean": "rimraf --glob cjs esm '*.tsbuildinfo'",
    "lint": "eslint src",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "prettier": "^3",
    "yaml": ">=2"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    },
    "yaml": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
